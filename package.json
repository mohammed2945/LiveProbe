{
  "name": "liveprobe",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native live production debugger",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "audit:readonly": "node scripts/readonly-audit.mjs",
    "audit:redaction": "sh scripts/redaction-audit.sh",
    "bench": "pnpm --filter @doomslayer2945/liveprobe-node run bench && sh scripts/python312.sh python/sdk/benchmarks/monitoring_overhead.py",
    "build": "pnpm --recursive run build",
    "demo": "make demo",
    "demo:down": "make demo-down",
    "e2e:jvm": "make e2e-jvm",
    "e2e:node": "make e2e-node",
    "e2e:python": "make e2e-python",
    "eval:praxis:artifact-compat": "python3.12 evaluation/praxis/python/check_praxis_artifact_compatibility.py --artifact-root \"$PRAXIS_ARTIFACT_ROOT\" --output evaluation/praxis/results/praxis-artifact-compatibility.json",
    "eval:praxis:compat": "python3.12 evaluation/praxis/python/check_liveprobe_compatibility.py --source-root .eval-cache/praxis-sources --output evaluation/praxis/results/liveprobe-compatibility.json",
    "eval:praxis:contract": "node --test evaluation/praxis/test/contracts.test.mjs",
    "eval:praxis:fixture": "node evaluation/praxis/src/benchmark.mjs --mode=fixture --output=evaluation/praxis/results/fixture.json",
    "eval:praxis:preflight": "node evaluation/praxis/scripts/remote-preflight.mjs",
    "eval:praxis:report": "node evaluation/praxis/src/report.mjs",
    "fixtures:validate": "node scripts/validate-fixtures.mjs",
    "test": "pnpm run fixtures:validate && pnpm run typecheck && pnpm run test:packages",
    "test:packages": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "gpt-tokenizer": "^3.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
