{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liveprobe.dev/schemas/praxis-diagnosis-v1.json",
  "title": "LiveProbe PRAXIS Evaluation Diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "root_cause",
    "mechanism",
    "propagation",
    "remediation",
    "confidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["LOCALIZED", "HANDOFF", "INSUFFICIENT"]
    },
    "root_cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "kind",
        "service",
        "file",
        "line",
        "function",
        "namespace",
        "resource",
        "config_path"
      ],
      "properties": {
        "entity": {"type": "string"},
        "kind": {"type": "string"},
        "service": {"type": ["string", "null"]},
        "file": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"]},
        "function": {"type": ["string", "null"]},
        "namespace": {"type": ["string", "null"]},
        "resource": {"type": ["string", "null"]},
        "config_path": {"type": ["string", "null"]}
      }
    },
    "mechanism": {
      "type": "string"
    },
    "propagation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "evidence_ids", "explanation"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "explanation": {"type": ["string", "null"]}
        }
      }
    },
    "remediation": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    }
  }
}
